# -------------------------
# Stage 1: Build React App
# -------------------------
FROM nexus.dorsa.cloud/library/node:18-bullseye-slim AS builder
WORKDIR /app

# Copy .npmrc for custom registry (ensures Nexus is used during install)
COPY .npmrc ./

# Copy dependency definitions and install (use npm ci for lockfile fidelity; add flags for speed/reliability)
# Temporarily add --verbose for debugging; remove once fixed
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund --maxsockets=10 --verbose

# Copy the rest of the app
COPY . .

# Set environment variable for production build
ENV REACT_APP_PRODUCTION_URL_V1="https://dctm.ir"
RUN npm run build

# Optional: Clean up .npmrc if you don't want it in image layer (but harmless to leave for prod)
RUN rm -f .npmrc

# -------------------------
# Stage 2: Serve via NGINX
# -------------------------
FROM nexus.dorsa.cloud/library/nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# Copy built React app from builder
COPY --from=builder /app/build /usr/share/nginx/html

# Replace default nginx config
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d

EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]