# -------------------------
# Stage 1: Build React App
# -------------------------
FROM nexus.dorsa.cloud/library/node:18-bullseye-slim AS builder
WORKDIR /app

# Copy .npmrc for custom registry (ensure it includes auth; see notes below)
COPY .npmrc ./

# Copy dependency definitions and install (remove --verbose once working)
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit --no-fund --maxsockets=10

# Copy the rest of the app
COPY . .

# Set environment variable for production build
ENV REACT_APP_PRODUCTION_URL_V1="https://dctm.ir"
RUN npm run build

# Optional: Clean up
RUN rm -f .npmrc

# -------------------------
# Stage 2: Serve via NGINX
# -------------------------
FROM nexus.dorsa.cloud/library/nginx:1.25-alpine

WORKDIR /usr/share/nginx/html

# Copy built app from builder
COPY --from=builder /app/build /usr/share/nginx/html

# Replace default nginx config
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d

EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]